{
  // Server configuration schema version.
  "version": 6,

  // Process-wide low-level Server settings.
  "settings": {
    // One ABI governs all Projects and the single SHM layout.
    "abi": {
      "target": "windows-x64",
      "pack": 8
    },

    // Runtime/SHM materialization policy for this Server process.
    "shm": {
      // fixed_direct | relocatable_transfer
      "mode": "fixed_direct",

      // Stable logical name of the one Project SHM.
      "name": "CW.ServerEngineV4.Project",

      // Required only for fixed_direct.
      "fixed_base_address": "0x0000010000000000"
    },

    // Standard filenames inside each Project artifact directory.
    "files": {
      "manifest": "project.manifest",
      "source_save": "source.bin",
      "database": "database.bin",
      "compiled": "compiled.bin"
    }
  },

  // Only listed endpoints are created.
  "communication": {
    "endpoints": [
      {
        "name": "console",
        "transport": "console"
      }
    ]
  },

  // Optional startup Project:
  // "project": {
  //   "path": "project.json",
  //   "startup": "load" // load | publish | rebuild
  // },

  "logging": {
    "level": "info",
    "console": true,
    "file": "logs/server.log"
  },

  "telemetry": {
    "console": true,
    "subsystems": [
      "server",
      "communication",
      "project",
      "load",
      "publish",
      "build",
      "rebuild",
      "unload",
      "runtime",
      "persistence"
    ]
  }
}
