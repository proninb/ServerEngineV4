{
  // Server configuration schema version.
  "version": 2,

  // One process-wide ABI governs all Projects and the single SHM layout.
  "abi": {
    "target": "windows-x64",
    "pack": 8
  },

  // Standard filenames inside each Project artifact directory.
  // This contract exists even when no startup Project is configured.
  "project_files": {
    "manifest": "project.manifest",
    "source_save": "source.bin",
    "database": "database.bin",
    "compiled": "compiled.bin",
    "baseline": "baseline.bin"
  },

  // Only listed endpoints are created.
  "communication": {
    "endpoints": [
      {
        "name": "console",
        "transport": "console"
      }
    ]
  },

  // Optional startup Project:
  // "project": {
  //   "path": "project.json",
  //   "startup": "load"
  // },

  "logging": {
    "level": "info",
    "console": true,
    "file": "logs/server.log"
  },

  "telemetry": {
    "console": true,
    "subsystems": [
      "server",
      "communication",
      "project",
      "load",
      "build",
      "rebuild",
      "unload",
      "runtime",
      "persistence"
    ]
  }
}
