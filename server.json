{
  // Server configuration schema version.
  "version": 1,

  // One process-wide ABI governs all Projects and the single SHM layout.
  "abi": {
    "target": "windows-x64",
    "pack": 8
  },

  // Only listed endpoints are created.
  "communication": {
    "endpoints": [
      {
        "name": "console",
        "transport": "console"
      }
    ]
  },

  // Optional startup Project:
  // "project": {
  //   "path": "project.json",
  //   "startup": "load"
  // },

  "logging": {
    "level": "info",
    "console": true,
    "file": "logs/server.log"
  },

  "telemetry": {
    "console": true,
    "subsystems": [
      "server",
      "communication",
      "project",
      "load",
      "build",
      "rebuild",
      "save",
      "unload",
      "runtime",
      "persistence"
    ]
  }
}
